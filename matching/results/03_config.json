{
  "rules": {
    "client_col": "client_ratio",
    "matter_col": "matter_token_sort_ratio",
    "client_min": 65,
    "matter_min": 70,
    "no_match_max": 80,
    "phrase_min": 90,
    "multi_other_client": true,
    "accept_cue_only": false,
    "require_history": true,
    "flag_cue_conflict": false,
    "cue_fit_agrees": true,
    "history_within_client": true,
    "bad_cmid_use_text": true,
    "bad_cmid_accept_closest": true,
    "bad_cmid_fallback": "NO_MATCH",
    "shortlist_size": 3
  },
  "precision_target": 0.98
}